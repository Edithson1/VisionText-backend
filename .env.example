# PLANTILLA LOCAL: copia como .env y completa los valores para Start-Local.ps1 o Compose.
# Para Supabase/Drive/Render usa .env.render (consulta ENVIRONMENT.md).
# La contraseña de Supabase no va en este archivo local.

# Servidor local
HOST=0.0.0.0
PORT=8000

# URL pública del backend: se usa para construir las URLs de imágenes que recibe el navegador
BASE_URL=http://localhost:8000

# CLIP Model
CLIP_BACKEND=onnx
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai
CACHE_DIR=./model_cache
ONNX_MODEL_DIR=./model_cache/onnx
ONNX_PRECISION=q8f16
INFERENCE_THREADS=1
MAX_CONCURRENT_INFERENCE=1
# Opcional si ya tienes los pesos locales del modelo seleccionado.
# CLIP_CHECKPOINT=/ruta/al/modelo.pt

# PostgreSQL LOCAL: Start-Local.ps1 y Compose necesitan esta contraseña.
POSTGRES_PASSWORD=cambia-esta-clave-local
# Solo si ejecutas uvicorn directamente: configura host/puerto de tu PostgreSQL.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=visiontext
POSTGRES_DB=visiontext

STORAGE_BACKEND=s3
# Para la nube: STORAGE_BACKEND=google_drive y las variables de .env.render.example.

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=cambia-este-usuario
MINIO_SECRET_KEY=cambia-esta-clave
MINIO_SECURE=false
MINIO_BUCKET_IMAGES=visiontext-images
MINIO_BUCKET_THUMBNAILS=visiontext-thumbnails

# FAISS Index
FAISS_INDEX_PATH=./faiss_indices/faiss_index.bin

# Search & Upload
MAX_UPLOAD_SIZE=10485760
MAX_IMAGE_PIXELS=4000000
MAX_IMAGE_DIMENSION=1600
EMBEDDING_BATCH_SIZE=32
THUMBNAIL_SIZE=256
DEFAULT_SEARCH_LIMIT=20
TEXT_SEARCH_THRESHOLD=0.18
IMAGE_SEARCH_THRESHOLD=0.65
SIMILARITY_THRESHOLD=0.20

# CORS: orígenes del frontend separados por comas
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin (genera JWT_SECRET_KEY con: openssl rand -hex 32)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave
JWT_SECRET_KEY=cambia-este-secreto

# Límite de intentos fallidos de login (opcional)
LOGIN_MAX_ATTEMPTS_PER_IP=5
LOGIN_MAX_ATTEMPTS_PER_USERNAME=10
LOGIN_WINDOW_SECONDS=900
