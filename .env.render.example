# PLANTILLA PUBLICA: no pongas secretos reales en este archivo.
# Genera tu archivo privado: python scripts/prepare_render_env.py
# .env.render se importa en Render; no se carga al iniciar el backend local.

# 1. SUPABASE: escribe la contraseña real SOLO en .env.render (POSTGRES_PASSWORD).
# Es la contraseña de PostgreSQL del proyecto, distinta del secreto de Google.
POSTGRES_HOST=aws-0-us-east-2.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.rallvjbmmlezptdhtfzx
POSTGRES_SSL=require
POSTGRES_PASSWORD=

# 2. GOOGLE DRIVE: el preparador copia las credenciales de .env.drive.
STORAGE_BACKEND=google_drive
GOOGLE_DRIVE_CLIENT_ID=671243718941-v9qphoe5a4ipkefbj897q5ev543b3uiu.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# El autorizador crea esta carpeta y escribe su ID en .env.drive.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=VisionText
GOOGLE_DRIVE_NAMESPACE=visiontext-rallvjbmmlezptdhtfzx
STORAGE_TIMEOUT_SECONDS=20

# 3. ADMINISTRADOR: se conservan las credenciales locales si están disponibles.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Se genera una clave independiente para la nube; conserva su valor.
JWT_SECRET_KEY=

# 4. DIRECCIONES: reemplaza estos valores por el backend y frontend publicados.
BASE_URL=https://visiontext-backend.onrender.com
CORS_ORIGINS=https://visiontext-sigma.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# 5. MODELO Y LIMITES: perfil preparado para Render Free.
CLIP_BACKEND=onnx
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai
ONNX_PRECISION=q8f16
ONNX_MODEL_DIR=/opt/clip-onnx
INFERENCE_THREADS=1
MAX_CONCURRENT_INFERENCE=1
MAX_UPLOAD_SIZE=10485760
MAX_IMAGE_PIXELS=4000000
MAX_IMAGE_DIMENSION=1600
EMBEDDING_BATCH_SIZE=32
