ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET_KEY=
BASE_URL=https://TU-SERVICIO.onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CLIP_BACKEND=onnx
CLIP_MODEL=ViT-B-32
